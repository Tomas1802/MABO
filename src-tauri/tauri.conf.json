{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MABO",
  "version": "2.0.1",
  "identifier": "io.github.tomas1802.mabo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MABO",
        "width": 1100,
        "height": 700,
        "minWidth": 400,
        "minHeight": 250,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "MABO",
    "shortDescription": "A fast, beautiful terminal for the coding-agent era",
    "license": "MIT",
    "homepage": "https://github.com/Tomas1802/MABO",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QTM4NzQ3MUUyQjQyMzMKUldRelFpc2VSNGVqcUd0Uy80bm9UalNvU1B0NWRuWTJiTEVubThjcFUra3Q0RWh4THdKZk5pSlEK",
      "endpoints": [
        "https://github.com/Tomas1802/MABO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
